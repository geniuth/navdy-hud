<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.geniu.navdyhud"
    android:versionCode="1"
    android:versionName="0.1">
  <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22" />
  <uses-permission android:name="android.permission.BLUETOOTH" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application android:label="CommaHUD" android:hardwareAccelerated="true">
    <activity android:name=".HudActivity"
              android:label="CommaHUD"
              android:screenOrientation="landscape"
              android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
              android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- 전원을 껐다 켜면 순정 UI 만 올라오므로 HUD 를 스스로 띄운다. -->
    <receiver android:name=".BootReceiver">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
    <service android:name=".BootService" />

    <!-- 어느 화면에서든 다이얼 길게 누르기로 HUD 와 순정 화면을 오간다.
         켜는 법은 DialService.java 주석 참고(adb 로 한 번). -->
    <service android:name=".DialService"
             android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice"
                 android:resource="@xml/dial_service" />
    </service>
  </application>
</manifest>
